# e2e/.env로 복사해서 채우세요. .env는 git에 올라가지 않습니다. 아래 값은 개발용 자리표시자입니다.
JASCA_E2E_ADDR=127.0.0.1:18301
JASCA_E2E_ADMIN_PASSWORD=e2e-admin-pass-1234

# 테스트용 PostgreSQL 컨테이너. 매 실행마다 이 DB의 public 스키마를 지웁니다(이름에 e2e가 없으면 거부). 운영 DB를 넣지 마세요.
JASCA_E2E_DOCKER=docker
JASCA_E2E_PG_CONTAINER=jasca-pg
JASCA_E2E_PG_USER=jasca
JASCA_E2E_PG_DB=jasca_e2e
# 서버가 접속할 주소 (호스트에서 본 컨테이너 포트)
JASCA_E2E_DATABASE_URL=postgres://jasca:jasca-dev-pw@localhost:55440/jasca_e2e?sslmode=disable

# 개발용 Keycloak(start-dev) 컨테이너. keycloak-setup.sh가 realm/client/역할/사용자를 만듭니다.
JASCA_E2E_KC_CONTAINER=sori-kc
JASCA_E2E_KC_ISSUER=http://localhost:18080/realms/jasca
JASCA_E2E_KC_ADMIN_PASSWORD=admin-dev-pw
JASCA_E2E_KC_CLIENT_SECRET=jasca-dev-secret
JASCA_E2E_KC_SYNC_SECRET=jasca-sync-dev-secret
JASCA_E2E_KC_USER_PASSWORD=Kc-user-pass1
# Keycloak에 허용할 접속 주소(redirect). 공백으로 여러 개
JASCA_E2E_KC_REDIRECT_BASES="http://localhost:18301"

# 스캔 스위트용 Trivy. 바이너리는 이미지에서, DB는 도커 볼륨에서 e2e/.out으로 꺼냅니다. docker가 없으면 scan 스위트는 건너뜁니다.
JASCA_E2E_TRIVY_IMAGE=aquasec/trivy:0.76.1
JASCA_E2E_TRIVY_VOLUME=trivy-cache

# Playwright(playwright-core)와 Chromium. 비워 두면 일반 require 경로와 Playwright 기본 브라우저를 씁니다.
# 예: JASCA_E2E_PLAYWRIGHT=/path/to/node_modules/playwright-core
JASCA_E2E_PLAYWRIGHT=
# 예: JASCA_E2E_CHROME=$HOME/.cache/ms-playwright/chromium-XXXX/chrome-linux64/chrome
JASCA_E2E_CHROME=
# Chromium 공유 라이브러리가 따로 있을 때만. 예: $HOME/.local/chromelibs/usr/lib/x86_64-linux-gnu
JASCA_E2E_LD_LIBRARY_PATH=
